# Google Calendar booking integration
# Consumed by artifacts/hair-direction-salon/api/book-appointment.ts
# Set these in the Vercel project's Environment Variables — never commit real values.

# Service account email, e.g. booking-bot@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service account private key (the full PEM, including the BEGIN/END lines).
# If your value is stored on a single line, use literal \n for the line breaks —
# the function converts \n back into real newlines at runtime.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Target calendar ID (…@group.calendar.google.com, or the calendar owner's email)
GOOGLE_CALENDAR_ID=
