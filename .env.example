# Google Calendar booking integration
# Consumed by artifacts/hair-direction-salon/api/book-appointment.ts
# Set these in the Vercel project's Environment Variables — never commit real values.

# Service account email, e.g. booking-bot@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service account private key (the full PEM, including the BEGIN/END lines).
# If your value is stored on a single line, use literal \n for the line breaks —
# the function converts \n back into real newlines at runtime.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Target calendar ID (…@group.calendar.google.com, or the calendar owner's email)
GOOGLE_CALENDAR_ID=

# Resend API key for booking notification emails (customer confirmation + admin).
# Best-effort: if unset or sending fails, the booking still succeeds.
RESEND_API_KEY=

# Sanity write token (Editor perms) for mirroring bookings into Studio.
# Generate at sanity.io/manage. Server-only; best-effort — if unset or the write
# fails, the booking still succeeds.
SANITY_WRITE_TOKEN=

# Razorpay checkout (test mode for now). KEY_ID is the public key returned to the
# browser to open Checkout.js; KEY_SECRET is server-only (order creation +
# signature verification). Set both in Vercel env (Preview + Production).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
